{
    "include": [
        "modules/brightness.jsonc",
        "modules/clock.jsonc",
        "modules/custom.jsonc",
        "modules/network.jsonc",
        "modules/optional.jsonc",
        "modules/system_info.jsonc",
        "modules/pulseaudio.jsonc",
        "modules/workspaces.jsonc"
    ],
    "group/hardware": {
        "orientation": "inherit",
        "modules": [
            "temperature",
            "cpu",
            "memory",
            "disk"
        ]
    },
    "group/custom": {
        "orientation": "inherit",
        "modules": [
            "custom/pacman",
            "custom/weather",
            "custom/github"
            // "custom/hyprpicker"
        ]
    },
    "group/power": {
        "orientation": "inherit",
        "modules": [
            "custom/exit_session",
            "custom/lock",
            "custom/shutdown"
        ]
    },
    "group/device_status": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "pulseaudio",
            "network",
            "clock"
        ]
    },
    "group/hyprstatus": {
        "orientation": "inherit",
        "modules": [
            "custom/wallpaper",
            "custom/gamemode",
            "custom/hypridle",
            "idle_inhibitor"
        ]
    }
}
